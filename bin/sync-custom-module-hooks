#!/usr/bin/env ruby
# frozen_string_literal: true
# rubocop:disable Layout/LineLength

require 'json'

MANIFEST = if ENV['TEST_MANIFEST']
             JSON.parse(ENV['TEST_MANIFEST'], symbolize_names: true)
           else
             [
               {
                 file: 'app/javascript/dashboard/helper/actionCable.js',
