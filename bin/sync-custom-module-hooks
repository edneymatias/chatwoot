               },
               {
                 file: 'app/javascript/dashboard/routes/dashboard/dashboard.routes.js',
                 anchor: "            permissions: ['administrator', 'agent', 'custom_role'],\n          },",
                 insert: "          children: [\n            {\n              path: 'conversations/:conversationId',\n              name: 'opportunities_conversation',\n              roles: ['administrator', 'agent', 'custom_role'],\n              component: () =>\n                import(\n                  'dashboard/components-next/Opportunities/OpportunityConversationDrawer.vue'\n                ),\n            },\n          ],"
               },
               {
                 file: 'app/javascript/dashboard/components-next/sidebar/Sidebar.vue',
                 anchor: "    {\n      name: 'Portals',",
                 insert: "    ...(hasOpportunities.value\n      ? [\n          {\n            name: 'Opportunities',\n            label: t('SIDEBAR.OPPORTUNITIES'),\n            icon: 'i-lucide-kanban',\n            to: accountScopedRoute('opportunities_index'),\n            activeOn: ['opportunities_index'],\n          },\n        ]\n      : []),\n"
               },
               {
                 file: 'app/javascript/dashboard/components-next/sidebar/Sidebar.vue',
                 anchor: "          to: accountScopedRoute('macros_wrapper'),\n        },",
                 insert: "        ...(hasOpportunities.value\n          ? [\n              {\n                name: 'Settings Pipeline Stages',\n                label: t('SIDEBAR.PIPELINE_STAGES'),\n                icon: 'i-lucide-kanban',\n                to: accountScopedRoute('pipeline_stages_index'),\n              },\n            ]\n          : []),"
               },
               # Settings routes
               {
                 file: 'app/javascript/dashboard/routes/dashboard/settings/settings.routes.js',
                 anchor: "import macros from './macros/macros.routes';",
                 insert: "import pipelineStages from './pipelineStages/pipelineStages.routes';"
               },
               {
                 file: 'app/javascript/dashboard/routes/dashboard/settings/settings.routes.js',
                 anchor: '    ...macros.routes,',
                 insert: '    ...pipelineStages.routes,'
               },
               # store/index.js
               {
                 file: 'app/javascript/dashboard/store/index.js',
                 anchor: "import captainCustomTools from './captain/customTools';",
                 insert: "import pipelineStages from './modules/pipelineStages';\nimport opportunities from './modules/opportunities';"
               },
               {
                 file: 'app/javascript/dashboard/store/index.js',
                 anchor: '    captainCustomTools,',
                 insert: "    pipelineStages,\n    opportunities,"
               },
               # featureFlags.js
               {
                 file: 'app/javascript/dashboard/featureFlags.js',
                 anchor: 'export const FEATURE_FLAGS = {',
                 insert: "  OPPORTUNITIES: 'opportunities',"
               },
               # i18n index.js
               {
                 file: 'app/javascript/dashboard/i18n/locale/en/index.js',
                 anchor: "import macros from './macros.json';",
                 insert: "import opportunities from './opportunities.json';"
               },
               {
                 file: 'app/javascript/dashboard/i18n/locale/en/index.js',
                 anchor: '  ...macros,',
