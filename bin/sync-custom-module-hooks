mode = if ARGV[0] == '--check'
         :check
       elsif ARGV[0] == '--audit'
         :audit
       else
         :apply
       end

if mode == :audit
  base_ref = ARGV[1]
  if base_ref.to_s.strip.empty?
    current_branch = `git rev-parse --abbrev-ref HEAD`.strip
    base_ref = `git merge-base #{current_branch} develop`.strip
  end

  if base_ref.to_s.strip.empty? || !system("git rev-parse --verify #{base_ref} >/dev/null 2>&1")
    warn "ERROR: Unresolvable BASE_REF or no merge-base found: #{base_ref.inspect}"
    exit 1
  end

  # rubocop:disable Metrics/BlockLength
  excluded = lambda do |path|
    return true if path == 'db/schema.rb'
    return true if path.start_with?(
      'custom/', 'spec/', 'specs/', 'docs/', '.specify/', 'db/migrate/2026', 'db/migrate/2126',
      'app/javascript/dashboard/components-next/Opportunities/',
      'app/javascript/dashboard/routes/dashboard/opportunities/',
      'app/javascript/dashboard/store/modules/opportunities/',
      'app/javascript/dashboard/store/modules/pipelineStages/',
      'app/javascript/dashboard/store/modules/pipelineClosingRequiredFields/',
      'app/javascript/dashboard/store/modules/pipelineCardFieldConfigs/',
      'app/javascript/dashboard/store/modules/pipelineCurrencySetting/'
    )
    return true if [
      'app/javascript/dashboard/api/opportunities.js',
      'app/javascript/dashboard/i18n/locale/en/opportunities.json',
      'app/javascript/dashboard/i18n/locale/pt_BR/opportunities.json',
      'app/javascript/dashboard/api/scout.js',
      'app/javascript/dashboard/i18n/locale/en/scout.json',
      'app/javascript/dashboard/i18n/locale/pt_BR/scout.json'
    ].include?(path)
    return true if path.end_with?('.md', '_spec.rb', '.spec.js')
    return true if path.match?(%r{^(app/javascript/dashboard/i18n/locale|config/locales)/(?!en\b|pt_BR\b)})
    return true if path.start_with?(
      'app/javascript/dashboard/routes/dashboard/scout/',
      'app/javascript/dashboard/components-next/Scout/'
    )

    out_of_scope = [
      'config/initializers/rack_profiler.rb',
      'docker-compose.yaml', 'docker-compose.production.yaml', '.gitignore', 'AGENTS.md', '.specify/feature.json',
      'bin/sync-custom-module-hooks', 'lib/seeders/account_seeder.rb',
      'app/javascript/dashboard/components/widgets/conversation/ErpDataCard.vue',
      'app/javascript/dashboard/routes/dashboard/settings/automation/constants.js',
      'app/javascript/dashboard/api/pipelineStages.js',
      '.vscode/settings.json',
      '.github/workflows/publish_ee_docker.yml',
      '.github/workflows/run_foss_spec.yml',
      '.github/workflows/size-limit.yml',
      '.rubocop.yml',
      'app/javascript/dashboard/i18n/locale/pt_BR/conversation.json',
      'config/locales/en.yml',
      'config/locales/pt_BR.yml',
      'app/javascript/dashboard/i18n/locale/en/integrationApps.json',
      'app/javascript/dashboard/i18n/locale/pt_BR/integrationApps.json',
      'app/javascript/dashboard/i18n/locale/en/integrations.json',
      'app/javascript/dashboard/i18n/locale/pt_BR/integrations.json',
      'db/migrate/20231211010807_add_cached_labels_list.rb',
      'docker/entrypoints/helpers/pg_database_url.rb',
      'lib/tasks/captain_assistant_migration.rake',
      'lib/tasks/download_report.rake',
      'lib/tasks/meta_marketing.rake',
      'script/tag_contacts_from_csv.rb',
      'package.json',
      'pnpm-lock.yaml',
      'Gemfile.lock',
      'script/bulk_reindex_messages.rb',
      'script/monitor_reindex.rb',
      'script/reindex_single_account.rb'
    ]
    return true if out_of_scope.include?(path)

    if (path.start_with?('app/models/', 'enterprise/app/models/')) && path.end_with?('.rb')
      diff = `git diff -U0 #{base_ref} -- #{path}`
      return false if diff.empty?

      content = File.exist?(path) ? File.read(path) : ''
      lines = content.lines
      start_idx = lines.index { |l| l.start_with?('# == Schema Information') }
      return false unless start_idx

      end_idx = start_idx
      end_idx += 1 while end_idx < lines.length && lines[end_idx].match?(/^\s*(#|$)/)

      diff.lines.each do |line|
        if (match = line.match(/^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@/))
          new_start = match[1].to_i
          return false unless new_start.between?(start_idx + 1, end_idx + 1)
        elsif line.start_with?('+', '-') && !line.start_with?('+++', '---')
          return false unless line.match?(/^[+-]\s*(#|$)/)
        end
      end
      return true
    end

    false
  end
  # rubocop:enable Metrics/BlockLength

  modified_files = Set.new
  `git diff --name-status #{base_ref}...HEAD`.each_line do |line|
    status, path = line.strip.split("\t", 2)
    modified_files << path if status.start_with?('M') && !excluded.call(path)
  end

  `git diff --name-status`.each_line do |line|
    status, path = line.strip.split("\t", 2)
    modified_files << path if status.start_with?('M') && !excluded.call(path)
  end

  manifest_files = Set.new(MANIFEST.map { |e| e[:file] })

  covered = []
  gap = []

  modified_files.each do |path|
    if manifest_files.include?(path)
      covered << path
    else
      gap << path
    end
  end

  covered.sort.each { |path| puts "covered   #{path}" }
  gap.sort.each { |path| puts "gap       #{path}   (needs MANIFEST entry)" }

  puts "#{gap.size} gaps found."

  exit 0
end

failures = false

MANIFEST.each do |entry|
  file_path = entry[:file]
  anchor = entry[:anchor]
  insert_text = entry[:insert]

  unless File.exist?(file_path)
    puts "ERROR: file not found: #{file_path}"
    failures = true
    break
  end

  content = File.read(file_path)

  if content.include?(insert_text) || (entry[:replace] && !content.include?(anchor))
    puts "present   #{file_path} (already has insert)" if mode == :check
    next
  end

  unless content.include?(anchor)
    warn "ERROR: anchor not found in #{file_path}: `#{anchor}`"
    failures = true
    break
  end

  if mode == :apply
    new_content = if entry[:replace]
                    content.sub(anchor, insert_text)
                  else
                    content.sub(anchor, "#{anchor}\n#{insert_text}")
                  end
    File.write(file_path, new_content)
    puts "inserted  #{file_path}"
  else
    puts "missing   #{file_path}"
    failures = true
  end
end

puts "All #{MANIFEST.size} wiring points present." if mode == :check && !failures

exit(failures ? 1 : 0)

