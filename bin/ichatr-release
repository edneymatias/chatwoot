#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'

def run_cmd(cmd)
  stdout, stderr, status = Open3.capture3(cmd)
  [stdout.strip, stderr.strip, status]
end

def abort_with_error(msg)
  warn "\e[31mError: #{msg}\e[0m"
  exit 1
end

# T002: Dirty tree check
out, _err, status = run_cmd('git status --porcelain')
if !out.empty? || !status.success?
  abort_with_error("Working tree is dirty. Please commit or stash your changes before releasing.")
end

# T003: Base version parsing
package_json_path = File.join(__dir__, '..', 'package.json')
abort_with_error("package.json not found") unless File.exist?(package_json_path)

package_data = JSON.parse(File.read(package_json_path))
base_version = package_data['version']
abort_with_error("Could not determine base version from package.json") if base_version.nil? || base_version.empty?

# T004: Fetch existing tags and compute the next tag
tag_prefix = "#{base_version}-ichatr."
out, _err, status = run_cmd("git tag -l '#{tag_prefix}*'")
existing_tags = out.split("\n")

next_tag_number = 1
highest_tag = nil

if existing_tags.any?
  # Find the highest N in <base_version>-ichatr.<N>
  numbers = existing_tags.map do |tag|
    match = tag.match(/#{Regexp.escape(tag_prefix)}(\d+)$/)
    abort_with_error("Malformed tag found: #{tag}. Please fix manually.") unless match
    match[1].to_i
  end
  max_number = numbers.max
  highest_tag = "#{tag_prefix}#{max_number}"
  next_tag_number = max_number + 1
end

next_tag = "#{tag_prefix}#{next_tag_number}"

# T005: Changelog range logic
changelog_range = if highest_tag
                    "#{highest_tag}..HEAD"
                  else
                    "v#{base_version}..HEAD"
                  end

# T006: Interactive confirmation prompt
puts "Current base version: #{base_version}"
puts "Highest existing tag: #{highest_tag || 'None'}"
puts ""
puts "Next tag: \e[32m#{next_tag}\e[0m"
puts "Changelog range: #{changelog_range}"
puts ""
print "Are you sure you want to cut this release? This will push the tag to origin immediately. [y/N]: "
confirm = STDIN.gets.chomp.downcase

abort_with_error("Release aborted by user.") unless confirm == 'y' || confirm == 'yes'

# T007: Execute git tag and push
puts "Creating annotated tag #{next_tag}..."
_, err, status = run_cmd("git tag -a #{next_tag} -m \"Release #{next_tag}\"")
abort_with_error("Failed to create tag: #{err}") unless status.success?

puts "Pushing tag to origin..."
_, err, status = run_cmd("git push origin #{next_tag}")
abort_with_error("Failed to push tag: #{err}") unless status.success?

puts "\e[32mTag #{next_tag} created and pushed. CI pipeline will now generate release notes.\e[0m"
